# MediVault Backend Environment Variables
# Copy these into a file named .env and fill in the values.

# SERVER CONFIG
PORT=8005
FRONTEND_URL=http://localhost:5173

# OCR CONFIG
# On Windows, set this to the path of your tesseract.exe
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# AI PROVIDERS
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# FIREBASE
# Option 1: Provide full JSON from Service Account (Recommended for Render)
FIREBASE_CREDENTIALS_JSON='{"type": "service_account", ...}'
# Option 2: Local file path fallback
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
FIREBASE_STORAGE_BUCKET=healthcare-demo-xxxx.appspot.com

# RESEND (Email)
RESEND_API_KEY=re_xxx
MAIL_FROM_EMAIL=onboarding@resend.dev
MAIL_FROM_NAME=MediVault
